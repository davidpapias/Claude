# Copy to .env and fill in. Never commit .env.
# --- Supabase (local defaults printed by `supabase start`) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only. Used by the admin panel's server actions. Never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- App configuration ---
EXPO_PUBLIC_APP_NAME=Circulo
EXPO_PUBLIC_MIN_AGE=18
EXPO_PUBLIC_ANALYTICS_ENABLED=false
